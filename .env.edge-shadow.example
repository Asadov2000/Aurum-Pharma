# Hardened read-only Edge shadow rehearsal. This is not the production offline
# writer and must never be used to accept sales while Cloud is unavailable.
AURUM_EDGE_SECRET_FILES_DIR=/etc/aurum-edge/secrets
AURUM_EDGE_CLOUD_URL=https://pharmacy.example.com
AURUM_IMAGE_TAG=local

AURUM_EDGE_POSTGRES_MEMORY_LIMIT=1g
AURUM_EDGE_POSTGRES_CPU_LIMIT=1.0
AURUM_EDGE_WORKER_MEMORY_LIMIT=512m
AURUM_EDGE_WORKER_CPU_LIMIT=0.5
AURUM_EDGE_MAINTENANCE_MEMORY_LIMIT=512m
AURUM_EDGE_MAINTENANCE_CPU_LIMIT=0.5
AURUM_EDGE_LOG_MAX_SIZE=10m
AURUM_EDGE_LOG_MAX_FILES=5
