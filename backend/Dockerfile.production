# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG PYTHON_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

FROM ${PYTHON_IMAGE} AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_VERSION=26.2.1 \
    POETRY_VERSION=2.3.4 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --upgrade "pip==${PIP_VERSION}" "poetry==${POETRY_VERSION}"

COPY pyproject.toml poetry.lock ./
# Package-management tooling is build-only and must not expand the runtime attack surface.
RUN poetry install --only main --no-root --sync \
    && rm -rf \
        /app/.venv/bin/pip* \
        /app/.venv/lib/python3.12/site-packages/pip \
        /app/.venv/lib/python3.12/site-packages/pip-*.dist-info \
        /app/.venv/lib/python3.12/site-packages/pip-*.virtualenv


FROM ${PYTHON_IMAGE} AS runtime

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
        /usr/local/bin/pip* \
        /usr/local/lib/python3.12/site-packages/pip \
        /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
    && groupadd --gid 10001 aurum \
    && useradd --uid 10001 --gid aurum --no-create-home --shell /usr/sbin/nologin aurum

WORKDIR /app

COPY --from=builder /app/.venv /opt/venv
COPY --chown=10001:10001 app ./app
COPY --chown=10001:10001 alembic ./alembic
COPY --chown=10001:10001 alembic.ini pyproject.toml ./

USER 10001:10001

EXPOSE 8000
STOPSIGNAL SIGTERM

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-proxy-headers", "--no-server-header"]
