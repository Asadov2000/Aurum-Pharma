# Non-secret production settings only. Copy outside the repository and pass it
# with: docker compose --env-file /etc/aurum/production.env ...
AURUM_DOMAIN=pharmacy.example.com
AURUM_PUBLIC_ORIGIN=https://pharmacy.example.com
AURUM_ACME_EMAIL=ops@example.com
AURUM_SECRET_FILES_DIR=/etc/aurum/secrets

# Public host ports. Keep 80/443 for ACME and browser access.
AURUM_HTTP_PORT=80
AURUM_HTTPS_PORT=443

# The proxy gets one fixed address; the backend trusts only this address.
AURUM_APP_NETWORK_CIDR=172.30.0.0/24
AURUM_PROXY_IP=172.30.0.10

AURUM_IMAGE_TAG=local
AURUM_BACKEND_WORKERS=1
AURUM_CELERY_CONCURRENCY=2
AURUM_BILLING_WORKER_CONCURRENCY=1
AURUM_BILLING_TRANSITION_BATCH_SIZE=100
AURUM_LOG_LEVEL=INFO
AURUM_MFA_KEY_VERSION=1
AURUM_EMAIL_OUTBOX_KEY_VERSION=1

# Single-host safety limits. Tune only after measuring staging workloads.
AURUM_LOG_MAX_SIZE=10m
AURUM_LOG_MAX_FILES=5
AURUM_POSTGRES_MEMORY_LIMIT=2g
AURUM_POSTGRES_CPU_LIMIT=2.0
AURUM_REDIS_MEMORY_LIMIT=512m
AURUM_REDIS_CPU_LIMIT=1.0
# Keep this below the container limit to leave room for AOF and allocator overhead.
AURUM_REDIS_MAXMEMORY=384mb
AURUM_MINIO_MEMORY_LIMIT=1g
AURUM_MINIO_CPU_LIMIT=1.0
AURUM_BACKEND_MEMORY_LIMIT=768m
AURUM_BACKEND_CPU_LIMIT=1.0
AURUM_CELERY_MEMORY_LIMIT=1g
AURUM_CELERY_CPU_LIMIT=1.5
AURUM_CELERY_BEAT_MEMORY_LIMIT=384m
AURUM_CELERY_BEAT_CPU_LIMIT=0.5
AURUM_BILLING_WORKER_MEMORY_LIMIT=512m
AURUM_BILLING_WORKER_CPU_LIMIT=0.5
AURUM_MAILER_MEMORY_LIMIT=512m
AURUM_MAILER_CPU_LIMIT=0.5
AURUM_GATEWAY_MEMORY_LIMIT=256m
AURUM_GATEWAY_CPU_LIMIT=0.5
AURUM_PROMETHEUS_MEMORY_LIMIT=1g
AURUM_PROMETHEUS_CPU_LIMIT=1.0
AURUM_RECOVERY_EXPORTER_MEMORY_LIMIT=64m
AURUM_RECOVERY_EXPORTER_CPU_LIMIT=0.25
AURUM_MAINTENANCE_MEMORY_LIMIT=256m
AURUM_MAINTENANCE_CPU_LIMIT=0.5
AURUM_MIGRATION_MEMORY_LIMIT=512m
AURUM_MIGRATION_CPU_LIMIT=1.0

# Encrypted local recovery repository. It must be a dedicated host filesystem,
# outside Docker volumes and outside the Git checkout.
AURUM_BACKUP_REPOSITORY=/srv/aurum-backups/restic
AURUM_BACKUP_SCRATCH=/srv/aurum-backups/scratch
AURUM_WAL_ARCHIVE=/srv/aurum-backups/wal-archive
AURUM_RECOVERY_METRICS_DIR=/var/lib/aurum/recovery-metrics
AURUM_BACKUP_MIN_FREE_BYTES=5368709120
AURUM_BACKUP_MEMORY_LIMIT=768m
AURUM_BACKUP_CPU_LIMIT=1.0

# Independent S3-compatible account and region. Production requires HTTPS,
# bucket versioning and default Object Lock in COMPLIANCE mode.
AURUM_OFFSITE_ENDPOINT=https://s3.example.com
AURUM_OFFSITE_BUCKET=aurum-pharma-backups
AURUM_OFFSITE_PREFIX=aurum-production
AURUM_OFFSITE_ALLOW_INSECURE=false
AURUM_OFFSITE_SECRET_FILES_DIR=/etc/aurum/offsite-secrets

AURUM_EMAIL_HOST=smtp.example.com
AURUM_EMAIL_PORT=587
AURUM_EMAIL_USER=aurum@example.com
AURUM_EMAIL_FROM=no-reply@example.com
AURUM_EMAIL_USE_TLS=true
