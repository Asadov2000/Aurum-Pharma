# Environment
ENVIRONMENT=development
DEPLOYMENT_PROFILE=cloud

# Database (read by backend)
DATABASE_URL_APP=postgresql+asyncpg://aurum_app:aurum_app_pw@postgres:5432/aurum
DATABASE_URL_SUPPORT=postgresql+asyncpg://aurum_support:aurum_support_pw@postgres:5432/aurum
DATABASE_URL_MAILER=postgresql+asyncpg://aurum_mailer:aurum_mailer_pw@postgres:5432/aurum
DATABASE_URL_BILLING_WORKER=postgresql+asyncpg://aurum_billing_worker:aurum_billing_worker_pw@postgres:5432/aurum
DATABASE_URL_WORKER=postgresql+asyncpg://aurum_worker:aurum_worker_pw@postgres:5432/aurum
DATABASE_URL_CATALOG_WORKER=postgresql+asyncpg://aurum_catalog_worker:aurum_catalog_worker_pw@postgres:5432/aurum
# Maintenance-only; production mounts this only into the migration container.
DATABASE_URL_MIGRATION=postgresql+asyncpg://aurum_migrator:aurum_migrator_pw@postgres:5432/aurum

# Test database (pytest refuses database names without the _test suffix)
TEST_DATABASE_URL_APP=postgresql+asyncpg://aurum_app:aurum_app_pw@postgres-test:5432/aurum_test
TEST_DATABASE_URL_SUPPORT=postgresql+asyncpg://aurum_support:aurum_support_pw@postgres-test:5432/aurum_test
TEST_DATABASE_URL_MAILER=postgresql+asyncpg://aurum_mailer:aurum_mailer_pw@postgres-test:5432/aurum_test
TEST_DATABASE_URL_BILLING_WORKER=postgresql+asyncpg://aurum_billing_worker:aurum_billing_worker_pw@postgres-test:5432/aurum_test
TEST_DATABASE_URL_WORKER=postgresql+asyncpg://aurum_worker:aurum_worker_pw@postgres-test:5432/aurum_test
TEST_DATABASE_URL_CATALOG_WORKER=postgresql+asyncpg://aurum_catalog_worker:aurum_catalog_worker_pw@postgres-test:5432/aurum_test
TEST_DATABASE_URL_MIGRATION=postgresql+asyncpg://aurum_migrator:aurum_migrator_pw@postgres-test:5432/aurum_test

# Postgres bootstrap (used by docker-compose to init the container)
POSTGRES_PASSWORD=postgres
AURUM_APP_PASSWORD=aurum_app_pw
AURUM_SUPPORT_PASSWORD=aurum_support_pw
AURUM_MAILER_PASSWORD=aurum_mailer_pw
AURUM_BILLING_WORKER_PASSWORD=aurum_billing_worker_pw
AURUM_WORKER_PASSWORD=aurum_worker_pw
AURUM_CATALOG_WORKER_PASSWORD=aurum_catalog_worker_pw
AURUM_MIGRATOR_PASSWORD=aurum_migrator_pw
AURUM_BACKUP_PASSWORD=aurum_backup_pw
AURUM_PITR_PASSWORD=aurum_pitr_pw

# Redis
REDIS_PASSWORD=aurum_redis_pw
REDIS_URL=redis://:aurum_redis_pw@redis:6379/0
# Separate Celery identities; application cache keeps REDIS_URL above.
REDIS_CELERY_API_PASSWORD=aurum_api_broker_pw
REDIS_CELERY_BEAT_PASSWORD=aurum_beat_broker_pw
REDIS_CELERY_SYSTEM_PASSWORD=aurum_system_broker_pw
REDIS_CELERY_CATALOG_PASSWORD=aurum_catalog_broker_pw
REDIS_CELERY_BILLING_PASSWORD=aurum_billing_broker_pw
REDIS_CELERY_MAILER_PASSWORD=aurum_mailer_broker_pw
CELERY_API_BROKER_URL=redis://aurum_api:aurum_api_broker_pw@redis:6379/0
CELERY_BEAT_BROKER_URL=redis://aurum_beat:aurum_beat_broker_pw@redis:6379/0
CELERY_SYSTEM_BROKER_URL=redis://aurum_system:aurum_system_broker_pw@redis:6379/0
CELERY_CATALOG_BROKER_URL=redis://aurum_catalog:aurum_catalog_broker_pw@redis:6379/0
CELERY_BILLING_BROKER_URL=redis://aurum_billing:aurum_billing_broker_pw@redis:6379/0
CELERY_MAILER_BROKER_URL=redis://aurum_mailer:aurum_mailer_broker_pw@redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-long-random-string-min-32-bytes
# Обязателен в staging/production. Задайте до первого включения support-MFA.
# MFA_ENCRYPTION_KEY=generate-an-independent-random-secret-at-least-32-characters
# Версия текущего корневого ключа из secret manager.
# MFA_ENCRYPTION_KEY_VERSION=1
# Во время ротации храните предыдущие версии до завершения перешифрования.
# MFA_ENCRYPTION_PREVIOUS_KEYS={"1":"previous-random-secret-at-least-32-characters"}
# Separate keyring for encrypted invitation tokens in the transactional email outbox.
# EMAIL_OUTBOX_ENCRYPTION_KEY=generate-an-independent-random-secret-at-least-32-characters
# EMAIL_OUTBOX_ENCRYPTION_KEY_VERSION=1
# EMAIL_OUTBOX_ENCRYPTION_PREVIOUS_KEYS={"1":"previous-random-secret-at-least-32-characters"}
JWT_ALGORITHM=HS256
JWT_ISSUER=aurum-pharma
JWT_AUDIENCE=aurum-pharma-api
# Absolute UTC Unix timestamp for a one-time upgrade; 0 means strict access JWT only.
# A future value may be at most 15 minutes ahead at API startup. See ADR-0038.
JWT_LEGACY_ACCESS_UNTIL=0
# SMS: disabled by default. 'development' simulates delivery locally; never use
# it with real users. Payom supplies your HTTPS endpoint, bearer key and sender.
SMS_PROVIDER=disabled
# PAYOM_API_URL=https://your-assigned-host/api/message
# PAYOM_API_TOKEN=store-the-real-key-locally-never-in-git
PAYOM_SENDER_NAME=AurumPharma
SMS_TIMEOUT_SECONDS=10
SMS_DAILY_LIMIT=100
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Development only: prevents long credential lockouts while switching test
# accounts. Staging and production always enforce the strict login guard.
AUTH_LOCAL_TESTING_MODE=true
REFRESH_COOKIE_NAME=aurum_refresh_token
REFRESH_COOKIE_SAMESITE=lax
# Leave unset for automatic behavior: false in development, true in production.
# Set true manually only when backend is served over HTTPS.
# REFRESH_COOKIE_SECURE=true

# Metrics endpoint. Leave unset in development; staging/production require a
# random secret of at least 32 characters and Prometheus must send it as Bearer.
# METRICS_TOKEN=generate-a-random-secret-at-least-32-characters

# CORS — JSON array, exact origins, no "*" when allow_credentials=True
CORS_ORIGINS=["http://localhost:5173"]

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurum
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
CATALOG_MINIO_ACCESS_KEY=aurum_catalog_reader
CATALOG_MINIO_SECRET_KEY=aurum_catalog_reader_pw

# Local email catcher. Open http://localhost:8025 after requesting a login code.
# Production uses separate AURUM_EMAIL_* variables and requires verified TLS.
AURUM_DEV_EMAIL_HOST=mailpit
AURUM_DEV_EMAIL_PORT=1025
AURUM_DEV_EMAIL_USER=
AURUM_DEV_EMAIL_PASSWORD=
AURUM_DEV_EMAIL_FROM=no-reply@aurum-pharma.local
AURUM_DEV_EMAIL_USE_TLS=false
EMAIL_SMTP_TIMEOUT_SECONDS=10
EMAIL_OUTBOX_BATCH_SIZE=25
EMAIL_OUTBOX_CLAIM_TIMEOUT_SECONDS=300
BILLING_TRANSITION_BATCH_SIZE=100
PUBLIC_APP_URL=http://localhost:5173

# App
APP_NAME=Aurum Pharma
LOG_LEVEL=INFO

# Edge shadow pilot (development only; production transport will use mTLS)
EDGE_SYNC_ENABLED=false
EDGE_SYNC_MAX_CLOCK_SKEW_SECONDS=300
EDGE_SYNC_NONCE_TTL_SECONDS=600
EDGE_SYNC_REQUESTS_PER_MINUTE=120
EDGE_SYNC_POLL_SECONDS=5
EDGE_SYNC_BATCH_SIZE=100
EDGE_BOOTSTRAP_TTL_SECONDS=86400
EDGE_BOOTSTRAP_CHUNK_SIZE=100
EDGE_BOOTSTRAP_MAX_EVENTS=10000
EDGE_READ_SNAPSHOT_CHUNK_SIZE=500
EDGE_READ_SNAPSHOT_STALE_SECONDS=86400
EDGE_READ_SNAPSHOT_REFRESH_SECONDS=300
EDGE_WRITER_READINESS_ENABLED=false
EDGE_WRITER_ACTIVATION_ENABLED=false
# EDGE_SYNC_CLOUD_URL=http://backend:8000
# EDGE_SYNC_CREDENTIAL=edge_v1.<credential-id>.<one-time-secret>
# EDGE_DATABASE_URL_APP=postgresql+asyncpg://aurum_app:<password>@edge-postgres:5432/aurum_edge
# EDGE_DATABASE_URL_SUPPORT=postgresql+asyncpg://aurum_support:<password>@edge-postgres:5432/aurum_edge
# EDGE_DATABASE_URL_MIGRATION=postgresql+asyncpg://aurum_migrator:<password>@edge-postgres:5432/aurum_edge

# Frontend
# Local Docker uses the host backend. In production/PWA/Windows wrapper, leave
# this unset when frontend and backend are served from the same origin.
VITE_API_URL=http://localhost:8000/api/v1
# Optional public website HTTPS URL; loopback defaults to http://127.0.0.1:4174/.
VITE_PUBLIC_WEBSITE_URL=
