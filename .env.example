# Environment
ENVIRONMENT=development

# Database (read by backend)
DATABASE_URL_APP=postgresql+asyncpg://aurum_app:aurum_app_pw@postgres:5432/aurum
DATABASE_URL_SUPPORT=postgresql+asyncpg://aurum_support:aurum_support_pw@postgres:5432/aurum

# Postgres bootstrap (used by docker-compose to init the container)
POSTGRES_PASSWORD=postgres
AURUM_APP_PASSWORD=aurum_app_pw
AURUM_SUPPORT_PASSWORD=aurum_support_pw

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-long-random-string-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# CORS — JSON array, exact origins, no "*" when allow_credentials=True
CORS_ORIGINS=["http://localhost:5173"]

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurum
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# SMTP
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@aurum-pharma.tj
EMAIL_USE_TLS=true

# App
APP_NAME=Aurum Pharma
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
