# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG NODE_IMAGE=node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd
ARG CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
ARG GO_IMAGE=golang:1.26.9-alpine@sha256:cdfd4fe2da6b225d8b40c6b7a105736e548e83ff56d5d8f9394446eeb5eb84e0

FROM ${NODE_IMAGE} AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile

COPY . .
ARG VITE_PUBLIC_WEBSITE_URL
ENV VITE_PUBLIC_WEBSITE_URL=$VITE_PUBLIC_WEBSITE_URL
RUN pnpm build


FROM ${GO_IMAGE} AS caddy-builder

ARG TARGETARCH

WORKDIR /src

RUN --mount=type=cache,id=aurum-go-mod-${TARGETARCH},target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=aurum-go-build-${TARGETARCH},target=/root/.cache/go-build,sharing=locked \
    set -eu; \
    go mod init aurum.local/caddy; \
    attempt=1; \
    while true; do \
        if GODEBUG=http2client=0 go get github.com/caddyserver/caddy/v2/cmd/caddy@v2.11.4 \
            && GODEBUG=http2client=0 go get golang.org/x/net@v0.60.0 \
                golang.org/x/text@v0.42.0 \
                golang.org/x/crypto@v0.57.0 \
                google.golang.org/grpc@v1.83.2 \
            && go list -m golang.org/x/net golang.org/x/text golang.org/x/crypto \
            && GODEBUG=http2client=0 CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
                -o /usr/local/bin/caddy github.com/caddyserver/caddy/v2/cmd/caddy; then \
            break; \
        fi; \
        if [ "$attempt" -ge 3 ]; then \
            exit 1; \
        fi; \
        attempt=$((attempt + 1)); \
        sleep $((attempt * 2)); \
    done


FROM ${CADDY_IMAGE} AS runtime

RUN apk upgrade --no-cache \
    && apk del --no-cache curl libcurl \
    && addgroup -S -g 10001 aurum \
    && adduser -S -D -H -u 10001 -G aurum aurum \
    && chown -R 10001:10001 /config /data /srv

COPY --from=caddy-builder /usr/local/bin/caddy /usr/bin/caddy
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=builder --chown=10001:10001 /app/dist /srv

USER 10001:10001

EXPOSE 8080 8443 8443/udp
