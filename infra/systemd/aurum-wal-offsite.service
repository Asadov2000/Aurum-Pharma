[Unit]
Description=Aurum Pharma encrypted WAL and off-site WORM export
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aurum-pharma
ExecStart=/bin/sh ./scripts/run-production-recovery-cycle.sh wal
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
