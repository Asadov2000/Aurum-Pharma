[Unit]
Description=Aurum Pharma isolated restore drill
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aurum-pharma
Environment=AURUM_RECOVERY_METRICS_DIR=/var/lib/aurum/recovery-metrics
ExecStartPre=/usr/bin/install -d -m 0755 -o root -g root /var/lib/aurum/recovery-metrics
ExecStart=/bin/sh ./scripts/run-production-restore-drill.sh
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aurum/recovery-metrics /run/lock

[Install]
WantedBy=multi-user.target
