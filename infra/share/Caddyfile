{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	request_header -Tailscale-User-Login
	request_header -Tailscale-User-Name
	request_header -Tailscale-User-Profile-Pic

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@blocked path /metrics /docs* /redoc* /openapi.json
	handle @blocked {
		respond 404
	}

	handle /api/* {
		request_body {
			max_size 16MB
		}
		reverse_proxy backend:8000 {
			header_up Host backend
			health_uri /healthz
			health_headers {
				Host backend
			}
			lb_try_duration 5s
			transport http {
				dial_timeout 3s
				response_header_timeout 60s
			}
		}
	}

	handle /healthz {
		respond 200
	}

	handle /assets/* {
		reverse_proxy frontend:5173 {
			header_up Host localhost
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	handle {
		header Cache-Control "no-cache"
		reverse_proxy frontend:5173 {
			header_up Host localhost
		}
	}
}
